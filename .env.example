# Phinary Arc environment. Copy to .env and fill in. Never commit .env.
# VITE_* values are bundled into the browser app: never put a secret in one.

# ---------------------------------------------------------------------------
# Frontend (and read by the scripts)
# ---------------------------------------------------------------------------

# testnet (default, chain 5042002) | mainnet (chain 5042). Any other value fails at load.
VITE_NETWORK=testnet

# Optional RPC overrides. Defaults: https://rpc.testnet.arc.io + wss://rpc.testnet.arc.io,
# or https://rpc.mainnet.arc.io + wss://rpc.mainnet.arc.io on mainnet.
VITE_RPC_HTTP=
VITE_RPC_WS=

# Contracts (printed by contracts/script/DeployPhinary.s.sol)
VITE_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
# First deploy block; bounds History, claim and keeper log scans.
VITE_DEPLOY_BLOCK=0

# One feed per asset: MockAggregator on testnet, StreamsFeed on mainnet.
# An asset is offered (UI, keeper, setup) only when its feed is set; at least one is required.
VITE_FEED_BTC=0x0000000000000000000000000000000000000000
VITE_FEED_ETH=0x0000000000000000000000000000000000000000
VITE_FEED_SOL=0x0000000000000000000000000000000000000000
VITE_FEED_NVDA=
VITE_FEED_AAPL=

# Public keeper address(es), comma separated. Markets they create are the rolling markets.
VITE_KEEPER_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Scripts only (keeper, setup). Not bundled into the app.
# ---------------------------------------------------------------------------

# testnet (default) | mainnet. Must match VITE_NETWORK.
NETWORK=testnet
# Optional RPC override for the scripts.
RPC_URL=

# Keeper wallet key. Secret. Each keeper instance needs its own key.
KEEPER_PRIVATE_KEY=

# Several keepers: same KEEPER_COUNT, distinct KEEPER_INDEX (0-based), the others' addresses in KEEPER_PEERS.
# KEEPER_COUNT=1
# KEEPER_INDEX=0
# KEEPER_PEERS=
# KEEPER_PUSH_PRICES=true

# Mainnet only: Chainlink Data Streams API credentials (secret). The keeper exits without them
# unless KEEPER_PUSH_PRICES=false.
STREAMS_API_KEY=
STREAMS_API_SECRET=
# Default: https://api.dataengine.chain.link (mainnet), https://api.testnet-dataengine.chain.link (testnet)
# STREAMS_API_URL=
# setup.ts checks each deployed StreamsFeed against these stream ids (defaults are built in):
# STREAMS_FEED_ID_BTC=
# STREAMS_FEED_ID_ETH=
# STREAMS_FEED_ID_SOL=
# STREAMS_FEED_ID_NVDA=
# STREAMS_FEED_ID_AAPL=

# setup.ts: vault deposit amount in USDC (mainnet deposits only when set). SETUP_FORCE=1 re-registers testnet feeds.
# DEPOSIT_USDC=
# SETUP_FORCE=

# Optional price source overrides for the testnet keeper
# COINBASE_API_URL=https://api.exchange.coinbase.com
# KRAKEN_API_URL=https://api.kraken.com

# Optional inside Arc Studio only (testnet scripts)
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=

# ---------------------------------------------------------------------------
# Deploy script (contracts/script/DeployPhinary.s.sol), usually passed inline
# ---------------------------------------------------------------------------
# OWNER=0x...            owns every contract and sends every transaction
# ASSETS=0,1,2,3,4       optional subset (0 BTC, 1 ETH, 2 SOL, 3 NVDA, 4 AAPL)
# ORACLE=0x...           optional: only add the ASSETS feeds to this existing adapter
# MAX_REPORT_AGE=5       mainnet StreamsFeed age limit for trading-round reports, seconds

# Fork tests: pin a block to avoid RPC rate limits
# ARC_FORK_BLOCK=
